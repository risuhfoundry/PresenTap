# PresenTap — environment variables (template)
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to the
# browser; they are safe by design (Supabase anon/publishable keys only).

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (public — safe in the browser).
# Limit its privileges via Supabase > Project Settings > API > anon key scopes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NOTE: Phase 2 (Authentication & Organization) does NOT require the
# service-role key. Organization creation during onboarding is performed by a
# SECURITY DEFINER RPC (supabase/migrations/0014_onboarding_rpc.sql) invoked
# through the authenticated client, so no secret is exposed to the browser or
# shipped in the app bundle. The service-role key remains server-only and is
# introduced later for the device (ESP8266) ingestion path per the architecture.
# SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-expose
